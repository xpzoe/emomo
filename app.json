{
  "expo": {
    "name": "emomo",
    "slug": "emomo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "emomo",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.emomo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "emomo 会用当前位置读取当地天气，并在打卡时保存天气快照。"
      }
    },
    "android": {
      "package": "com.example.emomo"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ffd447"
        }
      ]
    ]
  }
}
